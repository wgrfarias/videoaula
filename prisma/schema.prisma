generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so Role / OrderStatus are plain strings.
// Valid values are enforced in application code — see src/lib/constants.ts.

model User {
  id            String   @id @default(cuid())
  name          String
  nickname      String?
  email         String   @unique
  passwordHash  String?
  role          String   @default("STUDENT")
  avatarUrl     String?
  bio           String?
  // CPF (Brazilian tax id), stored digits-only. Nullable so OAuth sign-ups
  // can complete it afterwards, but the player blocks watching until set —
  // it's what gets burned into the on-screen watermark.
  cpf           String?  @unique
  // % of this user's course sales the platform keeps when they're an
  // instructor. Irrelevant for STUDENT accounts.
  platformFeePercent Float @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coursesTaught Course[]        @relation("InstructorCourses")
  videos        Video[]         @relation("UploadedVideos")
  orders        Order[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
  comments      Comment[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  subtitle      String?
  description   String
  coverImageUrl String?
  // Used to render an auto-generated cover (/api/covers/[id]) when no image
  // was uploaded — see src/lib/covers.ts for the theme presets.
  coverTheme    String   @default("tech-blue")
  price         Float
  // 0-100. A course-specific sale price overrides the site-wide promo.
  discountPercent Float  @default(0)
  installments  Int      @default(1)
  accessDays    Int      @default(365)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructorId String
  instructor   User      @relation("InstructorCourses", fields: [instructorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  modules     Module[]
  orders      Order[]
  enrollments Enrollment[]

  // Self many-to-many: a "combo" course bundles other whole courses together.
  // A bundle course's effective content is its own modules (if any) plus the
  // modules of every course listed here.
  bundledCourses    Course[] @relation("CourseBundle")
  includedInBundles Course[] @relation("CourseBundle")
}

model Video {
  id           String   @id @default(cuid())
  title        String
  filename     String
  url          String
  mimeType     String?
  durationSec  Int?
  sizeBytes    Int?
  createdAt    DateTime @default(now())

  ownerId String
  owner   User   @relation("UploadedVideos", fields: [ownerId], references: [id])

  lessons Lesson[]
}

model Module {
  id       String @id @default(cuid())
  title    String
  order    Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id            String  @id @default(cuid())
  title        String
  description  String?
  order        Int     @default(0)
  freePreview  Boolean @default(false)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id])

  progress LessonProgress[]
  comments Comment[]

  @@index([moduleId])
}

// visibility: "PUBLIC" (every enrolled student + the instructor/admin can
// see it) or "PRIVATE" (only its author and the instructor/admin — a
// question aimed just at the teacher).
model Comment {
  id         String   @id @default(cuid())
  body       String
  visibility String   @default("PUBLIC")
  createdAt  DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Order {
  id        String      @id @default(cuid())
  amount    Float
  status    String      @default("PENDING")
  provider  String      @default("demo")
  createdAt DateTime    @default(now())
  paidAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])
}

model Enrollment {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// Singleton row (id is always "singleton") holding the editable text/links
// shown across the public site — managed from /admin. List-shaped fields
// (navLinks, socialLinks, faqItems) are stored as JSON-encoded strings since
// SQLite has no native Json column type.
model SiteContent {
  id String @id @default("singleton")

  siteName    String @default("Rumo à TI")
  siteTagline String @default("com Wagner Farias")

  heroBadgeText      String @default("Turma nova com vagas abertas")
  heroTitle          String @default("Dê o próximo passo rumo à sua carreira em TI")
  heroSubtitle       String @default("Aulas gravadas, direto ao ponto, para quem quer migrar de carreira ou evoluir em Tecnologia da Informação.")
  heroPrimaryLabel   String @default("Ver cursos disponíveis")
  heroPrimaryHref    String @default("/cursos")
  heroSecondaryLabel String @default("Conhecer o Wagner")
  heroSecondaryHref  String @default("/sobre")
  heroStatLine       String @default("+1.200 alunos em transição de carreira")

  footerTagline String @default("Cursos em vídeo para quem quer trilhar carreira em Tecnologia da Informação, com aulas gravadas, exercícios práticos e acompanhamento de progresso.")

  // Site-wide sale. A course's own discountPercent (if > 0) overrides this
  // for that course instead of stacking with it.
  promoActive           Boolean @default(false)
  promoGlobalDiscount    Float  @default(0)
  promoBannerText       String  @default("Promoção por tempo limitado!")

  // Optional video shown in the homepage hero instead of the placeholder.
  heroVideoUrl String?

  aboutTitle String @default("Quem é o Wagner Farias?")
  aboutBody  String @default("Wagner Farias atua há mais de 10 anos na área de Tecnologia da Informação, passando por times de infraestrutura, projetos e desenvolvimento.\n\nHoje dedica seu tempo a ajudar quem quer migrar de carreira ou dar os primeiros passos rumo à TI, com uma didática direta e sem enrolação.")

  navLinksJson    String @default("[{\"label\":\"Início\",\"href\":\"/\"},{\"label\":\"Cursos\",\"href\":\"/cursos\"},{\"label\":\"Quem é o Wagner?\",\"href\":\"/sobre\"},{\"label\":\"FAQ\",\"href\":\"/faq\"}]")
  socialLinksJson String @default("[{\"label\":\"Instagram\",\"href\":\"https://instagram.com\"},{\"label\":\"YouTube\",\"href\":\"https://youtube.com\"},{\"label\":\"LinkedIn\",\"href\":\"https://linkedin.com\"}]")
  faqItemsJson    String @default("[]")

  updatedAt DateTime @updatedAt
}

model LessonProgress {
  id            String   @id @default(cuid())
  watchedSeconds Int     @default(0)
  completed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
