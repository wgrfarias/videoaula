generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The schema was originally written for SQLite (hence no native enums —
// Role / OrderStatus are still plain strings, enforced in app code, see
// src/lib/constants.ts) and later moved to Postgres for production. Kept
// as plain strings on migration to avoid a second data-shape change.
// Valid values are enforced in application code — see src/lib/constants.ts.

model User {
  id            String   @id @default(cuid())
  name          String
  nickname      String?
  email         String   @unique
  passwordHash  String?
  role          String   @default("STUDENT")
  avatarUrl     String?
  bio           String?
  // CPF (Brazilian tax id), stored digits-only. Nullable so OAuth sign-ups
  // can complete it afterwards, but the player blocks watching until set —
  // it's what gets burned into the on-screen watermark.
  cpf           String?  @unique
  // % of this user's course sales the platform keeps when they're an
  // instructor. Irrelevant for STUDENT accounts.
  platformFeePercent Float @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coursesTaught Course[]        @relation("InstructorCourses")
  videos        Video[]         @relation("UploadedVideos")
  orders        Order[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
  comments      Comment[]
  couponRedemptions CouponRedemption[]
  pageViews         PageView[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  quizAttempts      QuizAttempt[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  subtitle      String?
  description   String
  coverImageUrl String?
  // Used to render an auto-generated cover (/api/covers/[id]) when no image
  // was uploaded — see src/lib/covers.ts for the theme presets.
  coverTheme    String   @default("tech-blue")
  price         Float
  // 0-100. A course-specific sale price overrides the site-wide promo.
  discountPercent Float  @default(0)
  installments  Int      @default(1)
  accessDays    Int      @default(365)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructorId String
  instructor   User      @relation("InstructorCourses", fields: [instructorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  modules     Module[]
  orders      Order[]
  enrollments Enrollment[]

  // Self many-to-many: a "combo" course bundles other whole courses together.
  // A bundle course's effective content is its own modules (if any) plus the
  // modules of every course listed here.
  bundledCourses    Course[] @relation("CourseBundle")
  includedInBundles Course[] @relation("CourseBundle")

  // Coupons restricted to specific courses/combos (scope = "COURSES"). A
  // sitewide coupon (scope = "SITEWIDE") isn't listed against any course.
  coupons           Coupon[]           @relation("CouponCourses")
  couponRedemptions CouponRedemption[]
  pageViews         PageView[]
  tickets           Ticket[]
}

model Video {
  id           String   @id @default(cuid())
  title        String
  filename     String
  url          String
  mimeType     String?
  durationSec  Int?
  sizeBytes    Int?
  // "upload" (file on disk, served/protected via /api/stream) or "youtube"
  // (url holds the watch/share URL; playback embeds YouTube directly, so
  // the platform's own access control only gates the course page around it).
  provider     String   @default("upload")
  createdAt    DateTime @default(now())

  ownerId String
  owner   User   @relation("UploadedVideos", fields: [ownerId], references: [id])

  lessons Lesson[]
}

model Module {
  id       String @id @default(cuid())
  title    String
  order    Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]
  quiz    Quiz?

  @@index([courseId])
}

model Lesson {
  id            String  @id @default(cuid())
  title        String
  description  String?
  order        Int     @default(0)
  freePreview  Boolean @default(false)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id])

  progress LessonProgress[]
  comments Comment[]

  @@index([moduleId])
}

// visibility: "PUBLIC" (every enrolled student + the instructor/admin can
// see it) or "PRIVATE" (only its author and the instructor/admin — a
// question aimed just at the teacher).
model Comment {
  id         String   @id @default(cuid())
  body       String
  visibility String   @default("PUBLIC")
  createdAt  DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Order {
  id        String      @id @default(cuid())
  amount    Float
  status    String      @default("PENDING")
  provider  String      @default("demo")
  createdAt DateTime    @default(now())
  paidAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  couponRedemption CouponRedemption?
}

// Admin-created discount code. discountType "PERCENT" (discountValue is
// 0-100) or "FIXED" (discountValue is a R$ amount). scope "SITEWIDE" applies
// to any course/combo; "COURSES" restricts it to whatever is listed in
// `courses`. A valid coupon replaces (never stacks with) the site promo or a
// course's own discountPercent — same "one clear discount" rule used there.
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountType   String
  discountValue  Float
  scope          String   @default("SITEWIDE")
  maxRedemptions Int?
  onePerCustomer Boolean  @default(false)
  expiresAt      DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  courses     Course[]           @relation("CouponCourses")
  redemptions CouponRedemption[]
}

// One row per (coupon, user, course): created with convertedAt = null the
// moment a customer applies the code at checkout, so admins can see coupons
// that were applied but never turned into a sale ("desistência"). Filled in
// with convertedAt + orderId once the purchase actually completes.
model CouponRedemption {
  id          String    @id @default(cuid())
  appliedAt   DateTime  @default(now())
  convertedAt DateTime?

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId, courseId])
  @@index([couponId])
}

model Enrollment {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// Singleton row (id is always "singleton") holding the editable text/links
// shown across the public site — managed from /admin. List-shaped fields
// (navLinks, socialLinks, faqItems) are stored as JSON-encoded strings since
// SQLite has no native Json column type.
model SiteContent {
  id String @id @default("singleton")

  siteName    String @default("Rumo à TI")
  siteTagline String @default("com Wagner Farias")

  heroBadgeText      String @default("Turma nova com vagas abertas")
  heroTitle          String @default("Dê o próximo passo rumo à sua carreira em TI")
  heroSubtitle       String @default("Aulas gravadas, direto ao ponto, para quem quer migrar de carreira ou evoluir em Tecnologia da Informação.")
  heroPrimaryLabel   String @default("Ver cursos disponíveis")
  heroPrimaryHref    String @default("/cursos")
  heroSecondaryLabel String @default("Conhecer o Wagner")
  heroSecondaryHref  String @default("/sobre")
  heroStatLine       String @default("+1.200 alunos em transição de carreira")

  footerTagline String @default("Cursos em vídeo para quem quer trilhar carreira em Tecnologia da Informação, com aulas gravadas, exercícios práticos e acompanhamento de progresso.")

  // Site-wide sale. A course's own discountPercent (if > 0) overrides this
  // for that course instead of stacking with it.
  promoActive           Boolean @default(false)
  promoGlobalDiscount    Float  @default(0)
  promoBannerText       String  @default("Promoção por tempo limitado!")

  // Optional video shown in the homepage hero instead of the placeholder.
  heroVideoUrl String?

  aboutTitle String @default("Quem é o Wagner Farias?")
  aboutBody  String @default("Wagner Farias atua há mais de 10 anos na área de Tecnologia da Informação, passando por times de infraestrutura, projetos e desenvolvimento.\n\nHoje dedica seu tempo a ajudar quem quer migrar de carreira ou dar os primeiros passos rumo à TI, com uma didática direta e sem enrolação.")

  navLinksJson    String @default("[{\"label\":\"Início\",\"href\":\"/\"},{\"label\":\"Cursos\",\"href\":\"/cursos\"},{\"label\":\"Quem é o Wagner?\",\"href\":\"/sobre\"},{\"label\":\"FAQ\",\"href\":\"/faq\"}]")
  socialLinksJson String @default("[{\"label\":\"Instagram\",\"href\":\"https://instagram.com\"},{\"label\":\"YouTube\",\"href\":\"https://youtube.com\"},{\"label\":\"LinkedIn\",\"href\":\"https://linkedin.com\"}]")
  faqItemsJson    String @default("[]")

  updatedAt DateTime @updatedAt
}

model LessonProgress {
  id            String   @id @default(cuid())
  watchedSeconds Int     @default(0)
  completed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// One row per page visit, updated in place as the visitor stays on the
// page (see src/components/analytics/page-view-tracker.tsx). Logged-in
// visitors are tied to `userId`; anonymous ones only carry `anonId`, a
// random id stored in a first-party cookie — never used to identify a
// person, just to avoid conflating unrelated anonymous visits.
model PageView {
  id          String   @id @default(cuid())
  path        String
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  anonId String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  @@index([path])
  @@index([courseId])
  @@index([userId])
}

// Admin-managed labels for support tickets (e.g. "Pagamento", "Acesso a
// aulas", "Dúvida de conteúdo") — created/edited in /admin/chamados.
model TicketCategory {
  id      String   @id @default(cuid())
  name    String   @unique
  tickets Ticket[]
}

model Ticket {
  id          String   @id @default(cuid())
  subject     String
  description String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   TicketCategory @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  messages TicketMessage[]

  @@index([status])
  @@index([authorId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// One quiz per Module (optional). Passing it (scorePercent >= passingPercent
// on some attempt) is what the player checks before unlocking the next
// module's lessons — see getModuleGating() in src/lib/data/quizzes.ts.
model Quiz {
  id             String @id @default(cuid())
  title          String @default("Questionário do módulo")
  passingPercent Float  @default(70)

  moduleId String @unique
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options QuestionOption[]

  @@index([quizId])
}

model QuestionOption {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  scorePercent Float
  passed       Boolean
  createdAt    DateTime @default(now())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([quizId])
  @@index([userId])
}
