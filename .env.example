# Postgres. Run `docker compose up -d` for a local instance matching this
# default, or point to a managed database (Fly Postgres, Supabase, Neon...).
DATABASE_URL="postgresql://videoaula:videoaula@localhost:5432/videoaula"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Where uploaded lesson videos are stored on disk
UPLOAD_DIR="./public/uploads"

# Optional: enables "Entrar com Google" on /entrar and /cadastro.
# Leave both unset to keep only e-mail/senha login.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID > Web application) with this redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: enables uploading lesson videos straight to a Bunny.net Stream
# library (the "Bunny.net" tab in the video library / lesson editor) instead
# of storing files on disk. Leave both unset to keep only local upload and
# YouTube links.
# Create a Video Library at https://dash.bunny.net/stream and grab its
# Library ID and its individual API Key (Library > API > Video Library API Key).
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""

# Optional: enables real payment via Stripe Checkout instead of the built-in
# demo flow (which approves every purchase instantly). Leave both unset to
# keep testing without a Stripe account.
# Get these at https://dashboard.stripe.com/apikeys (use the "test mode"
# keys while developing) and https://dashboard.stripe.com/webhooks (create
# an endpoint pointing at <sua-url>/api/webhooks/stripe, listening for
# checkout.session.completed and checkout.session.async_payment_succeeded).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
