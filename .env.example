# SQLite by default; swap for a Postgres URL in production
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Where uploaded lesson videos are stored on disk
UPLOAD_DIR="./public/uploads"

# Optional: enables "Entrar com Google" on /entrar and /cadastro.
# Leave both unset to keep only e-mail/senha login.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID > Web application) with this redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
